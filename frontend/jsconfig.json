{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["vite/client"],
    "paths": {
      "#lib/*": ["src/lib/*"]
    }
  },
  "include": ["src/**/*"]
}
