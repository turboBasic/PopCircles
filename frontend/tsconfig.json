{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["vite/client"],
    "paths": {
      "#lib/*": ["src/lib/*"]
    }
  },
  "include": ["src/**/*"]
}
