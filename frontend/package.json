{
  "name": "popcircles-gallery",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --workspace .",
    "dev": "vite",
    "preview": "vite preview",
    "test": "playwright install chromium && vitest run",
    "test:watch": "playwright install chromium && vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "playwright install chromium && vitest run --project component",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:ui": "playwright install chromium && playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.77.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@vitest/browser-playwright": "5.1.1",
    "bits-ui": "2.21.0",
    "cn": "0.3.3",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "1.8.1",
    "svelte": "5.57.3",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-browser-svelte": "3.1.0"
  }
}
