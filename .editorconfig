root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.rs]
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.html]
indent_size = 2

[*.{toml,yml,yaml,json,jsonc}]
indent_size = 2

# A committed dataset, so the layout is whatever its source serves: `data/README.md` records the
# checksum against the tag it came from, and reformatting the file to this repository's taste is what
# would make that checksum unverifiable. One line and no wrapping is what Natural Earth publishes.
[*.geojson]
max_line_length = off

# A committed result document is what the program printed, one line of it, and rewrapping one would stop
# it being that.
[results/*.json]
max_line_length = off

# insta generates these, so the layout is what it emits rather than what this file asks for. Trailing
# whitespace included: clap pads help output with it, and a snapshot that disagrees with what it recorded
# asserts nothing.
[*.snap]
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{sh,bash,zsh}]
indent_size = 2

[Makefile]
indent_style = tab
